{
  "name": "skybranch",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud-hosted employee hierarchy management",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
